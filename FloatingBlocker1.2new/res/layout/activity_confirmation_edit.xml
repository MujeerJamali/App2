<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/editConfirmationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/confirmation_name_hint" />

        <TextView
            android:id="@+id/txtLockedMessage"
            style="@style/LockedMessageBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/msg_confirmations_locked"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/confirmation_triggers_label"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/triggersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnPickTriggerTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_time_button" />

        <Button
            android:id="@+id/btnAddTrigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_trigger_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/confirmation_affected_blocks_label"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <Button
            android:id="@+id/btnSelectAffectedBlocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/select_blocks_button" />

        <Button
            android:id="@+id/btnSaveConfirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save_button" />

        <Button
            android:id="@+id/btnDeleteConfirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/delete_confirmation_button" />

    </LinearLayout>
</ScrollView>
