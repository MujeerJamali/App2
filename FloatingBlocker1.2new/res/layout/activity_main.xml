<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtDeviceOwnerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_owner_not_active"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnBlocksPause"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="@string/blocks_active" />

        <Button
            android:id="@+id/btnBlocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/blocks_button" />

        <Button
            android:id="@+id/btnLockSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/lock_schedule_button" />

        <Button
            android:id="@+id/btnHolidayBreaks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/holiday_breaks_button" />

        <Button
            android:id="@+id/btnWebsites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/websites_button" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnMasterSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/safety_engage_button" />

        <Button
            android:id="@+id/btnDeleteSafetyForever"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/safety_delete_forever_button" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBatteryExemption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/battery_exempt_off" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnVpnSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vpn_safety_engage_button" />

        <Button
            android:id="@+id/btnDeleteVpnSafetyForever"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vpn_safety_delete_forever_button" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnDiagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_button" />

    </LinearLayout>
</ScrollView>
