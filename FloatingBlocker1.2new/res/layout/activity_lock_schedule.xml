<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_schedule_desc"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/txtLockedMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/msg_lock_editing_locked"
            android:paddingBottom="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/start_time_label" />

            <Button
                android:id="@+id/btnPickEnd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/end_time_label" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAddRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_time_range_button" />

        <LinearLayout
            android:id="@+id/rangesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save_button" />

    </LinearLayout>
</ScrollView>
