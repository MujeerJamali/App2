<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/editBlockName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/block_name_hint" />

        <TextView
            android:id="@+id/txtLockedMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/msg_blocks_locked"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/block_ranges_label"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnPickStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/start_time_label" />

            <Button
                android:id="@+id/btnPickEnd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/end_time_label" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAddRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_time_range_button" />

        <LinearLayout
            android:id="@+id/rangesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/block_apps_label"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/own_app_always_allowed_note"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnAddApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_app_button" />

        <LinearLayout
            android:id="@+id/appsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save_button" />

        <Button
            android:id="@+id/btnDeleteBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/delete_block_button" />

    </LinearLayout>
</ScrollView>
