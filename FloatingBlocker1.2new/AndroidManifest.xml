<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mujeer.floatingblocker"
    android:versionCode="23"
    android:versionName="4.23">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="29" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:debuggable="false"
        android:directBootAware="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LockScheduleActivity"
            android:label="@string/lock_schedule_screen_title" />

        <activity
            android:name=".BlocksListActivity"
            android:label="@string/blocks_screen_title" />

        <activity
            android:name=".BlockEditActivity"
            android:label="@string/block_edit_screen_title" />

        <activity
            android:name=".HolidayBreaksListActivity"
            android:label="@string/holiday_breaks_screen_title" />

        <activity
            android:name=".HolidayBreakEditActivity"
            android:label="@string/holiday_break_edit_screen_title" />

        <activity
            android:name=".WebsitesListActivity"
            android:label="@string/websites_screen_title" />

        <activity
            android:name=".DiagnosticActivity"
            android:label="@string/diagnostic_screen_title" />

        <activity
            android:name=".ShareWebsiteActivity"
            android:label="@string/share_website_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".FloatingBlockerDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BlockAlarmReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <service
            android:name=".DnsVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
