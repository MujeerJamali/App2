<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mujeer.floatingblocker"
    android:versionCode="53"
    android:versionName="4.53">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="29" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".FloatingBlockerApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:debuggable="false"
        android:directBootAware="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LockScheduleActivity"
            android:label="@string/lock_schedule_screen_title" />

        <activity
            android:name=".BlocksListActivity"
            android:label="@string/blocks_screen_title" />

        <activity
            android:name=".BlockEditActivity"
            android:label="@string/block_edit_screen_title" />

        <activity
            android:name=".HolidayBreaksListActivity"
            android:label="@string/holiday_breaks_screen_title" />

        <activity
            android:name=".HolidayBreakEditActivity"
            android:label="@string/holiday_break_edit_screen_title" />

        <activity
            android:name=".WebsitesListActivity"
            android:label="@string/websites_screen_title" />

        <activity
            android:name=".BarcodesListActivity"
            android:label="@string/barcodes_screen_title" />

        <activity
            android:name=".BarcodeScanActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HomeLocationActivity"
            android:label="@string/home_location_screen_title" />

        <activity
            android:name=".AlarmsListActivity"
            android:label="@string/alarms_screen_title" />

        <activity
            android:name=".AlarmEditActivity"
            android:label="@string/alarm_edit_screen_title" />

        <activity
            android:name=".AlarmRingActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <activity
            android:name=".KioskSetupActivity"
            android:label="@string/kiosk_setup_screen_title" />

        <activity
            android:name=".KioskSessionActivity"
            android:label="@string/kiosk_session_title"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ShareWebsiteActivity"
            android:label="@string/share_website_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".FloatingBlockerDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BlockAlarmReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <receiver
            android:name=".AlarmRingReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <receiver
            android:name=".AlarmPunishmentDeadlineReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <receiver
            android:name=".KioskTimeoutReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <service
            android:name=".AlarmRingService"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
